# Local workspace the plugin proposes for mapper output / generated scripts
sz-workspace/
*_output.jsonl

# Local Claude Code state (settings.local.json, session scratch) — not published,
# but keep the shared settings.json (includeCoAuthoredBy) that the org standardizes on
.claude/*
!.claude/settings.json

# Python bytecode — a build artifact; one .pyc reached the repo through `git add -A` (PR #34)
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/*
# ...but keep the shared cspell dictionary (used by the spellcheck workflow)
!.vscode/cspell.json

# Built plugin release artifacts (produced by scripts/build-plugin-zip.sh)
dist/

# Behavioral eval output (`claude plugin eval ... --json evals/results/ci.json`)
**/evals/results/
# Real-Senzing eval output (sibling suite; same shape, different eval dir)
**/evals-real/results/

# Local credentials. THIS REPO IS PUBLIC — without this rule a `git add -A`
# after dropping an ANTHROPIC_API_KEY into .env.local publishes it. The eval
# runner loads .env.local so the suite can be run locally instead of only
# through CI (a CI-only eval costs ~55 min of queue per iteration).
.env
.env.*
